<mujoco model="evidence_room">
  <!--
    Evidence room scene. Lives beside panda.xml so Menagerie's relative asset paths resolve.
    The Panda base sits on the intake counter at the world origin; the counter top is z = 0 and the
    room floor is z = -0.8. The `tcp` site is added to the hand body at load time (scripts/scene.py),
    because MJCF cannot reopen a body declared in an included file.
  -->
  <include file="panda.xml"/>

  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <statistic center="0.3 0.1 0.1" extent="1.2"/>

  <visual>
    <headlight diffuse="0.3 0.3 0.3" ambient="0.18 0.18 0.18" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.40 0.47" rgb2="0.08 0.09 0.11" width="512" height="3072"/>
    <material name="floor_mat" rgba="0.33 0.34 0.35 1" specular="0" shininess="0" reflectance="0"/>
    <material name="counter_body" rgba="0.36 0.38 0.42 1"/>
    <material name="counter_top" rgba="0.66 0.67 0.69 1" specular="0.2"/>
    <material name="intake_mat" rgba="0.95 0.75 0.15 1"/>
    <!-- Opaque institutional grey, low specularity: reads as a steel evidence locker. -->
    <material name="cabinet_body" rgba="0.45 0.47 0.48 1" specular="0.12" shininess="0.2"/>
    <material name="cabinet_panel" rgba="0.53 0.55 0.56 1" specular="0.12" shininess="0.2"/>
    <material name="cabinet_trim" rgba="0.36 0.37 0.38 1" specular="0.1" shininess="0.2"/>
    <material name="cabinet_handle" rgba="0.70 0.71 0.72 1" specular="0.5" shininess="0.6"/>
    <material name="slot_floor" rgba="0.30 0.31 0.32 1" specular="0.05"/>
    <material name="evidence_tag" rgba="0.97 0.97 0.95 1" specular="0.05"/>
  </asset>

  <default>
    <default class="static">
      <geom type="box" contype="1" conaffinity="1" condim="3" friction="0.8 0.005 0.0001"/>
    </default>
    <default class="item">
      <!-- priority 1 makes the item's (randomised) friction govern its contacts, including with the finger pads;
           with equal priorities MuJoCo takes the max, which would make friction randomisation a no-op. -->
      <geom condim="4" priority="1" friction="1.2 0.02 0.0001" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    </default>
    <default class="slot">
      <site type="box" group="4" rgba="0.2 0.9 0.4 0.15"/>
    </default>
    <!-- Cabinet collision walls: unchanged physics, hidden (group 3, like Menagerie's collision meshes). -->
    <default class="cab_collision">
      <geom type="box" contype="1" conaffinity="1" condim="3" friction="0.8 0.005 0.0001" group="3"/>
    </default>
    <!-- Visual-only geometry: never collides, adds no mass or inertia. -->
    <default class="visual_only">
      <geom type="box" contype="0" conaffinity="0" density="0" group="0"/>
    </default>
  </default>

  <worldbody>
    <light name="key" pos="1.2 -1.0 2.2" dir="-0.45 0.35 -0.8" directional="true" castshadow="true"
      diffuse="0.55 0.55 0.52"/>
    <light name="fill" pos="-1.0 1.0 2.0" dir="0.4 -0.4 -0.8" directional="true" castshadow="false"
      diffuse="0.25 0.27 0.30"/>

    <geom name="floor" type="plane" pos="0 0 -0.8" size="0 0 0.05" material="floor_mat"/>

    <!-- Intake counter. The arm is mounted on it at the origin; items are presented in the intake zone. -->
    <body name="counter" pos="0.25 -0.125 0">
      <geom name="counter_body" class="static" pos="0 0 -0.41" size="0.5 0.325 0.39" material="counter_body"/>
      <geom name="counter_top" class="static" pos="0 0 -0.01" size="0.5 0.325 0.01" material="counter_top"/>
      <!-- Visual-only intake zone marking (no collision). -->
      <geom name="intake_zone" type="box" pos="0.25 0.025 0.0004" size="0.16 0.19 0.0004"
        contype="0" conaffinity="0" material="intake_mat" rgba="0.95 0.75 0.15 0.35"/>
    </body>

    <!--
      Cabinet: a 2x2 grid of open-topped storage bins on a base unit, to the arm's left (+y).
      Built from thin static boxes: floor, back wall, front wall, two side walls, one divider along x
      (the "vertical divider") and one along y (the "shelf"). There is deliberately no top panel:
      a closed top with a horizontal shelf would make top-down insertion into the lower row impossible.
      Each bin interior is 0.245 m (x) by 0.145 m (y) by 0.10 m deep.

      The walls exist twice: hidden collision boxes (class cab_collision, identical to Phase 0 so the physics is
      unchanged) and visual-only panels (class visual_only) that are thicker and, at the sides, taller, so the unit
      reads as a steel locker. The front and bin back walls stay at 0.108 m: the 208 mm-wide Panda hand passes over
      them at release with ~12 mm to spare, so they cannot be raised without changing the task.
    -->
    <body name="cabinet" pos="0.3 0.4 0">
      <geom name="cab_base" class="static" pos="0 0.025 -0.4" size="0.27 0.195 0.4" material="cabinet_body"/>
      <geom name="cab_floor" class="static" pos="0 0 0.004" size="0.26 0.16 0.004" material="slot_floor"/>
      <geom name="cab_back" class="static" pos="0 0.165 0.05" size="0.27 0.005 0.05" material="cabinet_panel"/>
      <!-- Tall backboard, set back from the bins so the 0.21 m-wide Panda hand clears it over the rear slots. -->
      <geom name="cab_backboard" class="cab_collision" pos="0 0.215 0.15" size="0.27 0.005 0.15"/>
      <geom name="cab_front" class="cab_collision" pos="0 -0.165 0.05" size="0.27 0.005 0.05"/>
      <geom name="cab_side_l" class="cab_collision" pos="-0.265 0 0.05" size="0.005 0.16 0.05"/>
      <geom name="cab_side_r" class="cab_collision" pos="0.265 0 0.05" size="0.005 0.16 0.05"/>
      <geom name="cab_divider" class="static" pos="0 0 0.05" size="0.005 0.16 0.05" material="cabinet_panel"/>
      <geom name="cab_shelf" class="static" pos="0 0 0.05" size="0.26 0.005 0.05" material="cabinet_panel"/>

      <!-- Visual locker shell. Inner faces sit on the collision walls' inner faces, so bin interiors look unchanged. -->
      <geom name="vis_carcass" class="visual_only" pos="0 0.025 -0.4" size="0.292 0.217 0.4" material="cabinet_body"/>
      <geom name="vis_front" class="visual_only" pos="0 -0.1765 0.054" size="0.292 0.0165 0.054"
        material="cabinet_panel"/>
      <geom name="vis_front_cap" class="visual_only" pos="0 -0.1765 0.1095" size="0.292 0.0175 0.0015"
        material="cabinet_trim"/>
      <geom name="vis_side_l" class="visual_only" pos="-0.276 0.025 0.08" size="0.0161 0.217 0.08"
        material="cabinet_panel"/>
      <geom name="vis_side_r" class="visual_only" pos="0.276 0.025 0.08" size="0.0161 0.217 0.08"
        material="cabinet_panel"/>
      <geom name="vis_backboard" class="visual_only" pos="0 0.226 0.15" size="0.292 0.016 0.15"
        material="cabinet_panel"/>
      <geom name="vis_backboard_cap" class="visual_only" pos="0 0.226 0.3015" size="0.294 0.018 0.0015"
        material="cabinet_trim"/>
      <!-- Locker doors on the two faces the demo camera sees (+x side, -y front), with pull handles. -->
      <geom name="vis_door_x1" class="visual_only" pos="0.2925 -0.075 -0.21" size="0.002 0.095 0.17"
        material="cabinet_trim"/>
      <geom name="vis_door_x2" class="visual_only" pos="0.2925 0.125 -0.21" size="0.002 0.095 0.17"
        material="cabinet_trim"/>
      <geom name="vis_handle_x1" class="visual_only" pos="0.297 0.005 -0.12" size="0.004 0.004 0.04"
        material="cabinet_handle"/>
      <geom name="vis_handle_x2" class="visual_only" pos="0.297 0.045 -0.12" size="0.004 0.004 0.04"
        material="cabinet_handle"/>
      <geom name="vis_door_y" class="visual_only" pos="0 -0.1935 -0.21" size="0.27 0.002 0.17"
        material="cabinet_trim"/>
      <geom name="vis_handle_y" class="visual_only" pos="0 -0.198 -0.07" size="0.06 0.004 0.004"
        material="cabinet_handle"/>
      <geom name="vis_plinth" class="visual_only" pos="0 0.025 -0.78" size="0.296 0.221 0.02"
        material="cabinet_trim"/>

      <!--
        Slot sites. Each is a box site whose pos is the centre of the bin's usable volume and whose
        size is the half-extent of that volume, so placement checks read the slot volume from the model.
      -->
      <site name="slot_0" class="slot" pos="-0.1325 -0.0825 0.058" size="0.1225 0.0725 0.05"/>
      <site name="slot_1" class="slot" pos="0.1325 -0.0825 0.058" size="0.1225 0.0725 0.05"/>
      <site name="slot_2" class="slot" pos="-0.1325 0.0825 0.058" size="0.1225 0.0725 0.05"/>
      <site name="slot_3" class="slot" pos="0.1325 0.0825 0.058" size="0.1225 0.0725 0.05"/>
    </body>

    <!-- Evidence items. All four are always in the model; only one is active per episode (see randomise.py). -->
    <body name="item_box" pos="0.52 -0.18 0.022">
      <freejoint name="item_box_joint"/>
      <geom name="item_box_geom" class="item" type="box" size="0.06 0.028 0.022" mass="0.25"
        rgba="0.72 0.48 0.26 1"/>
      <geom name="item_box_tag" class="visual_only" pos="0 0 0.0232" size="0.028 0.016 0.0012"
        material="evidence_tag"/>
    </body>
    <body name="item_bag" pos="0.62 0.0 0.025">
      <freejoint name="item_bag_joint"/>
      <!-- A soft bag modelled as a rigid ellipsoid would rock and spin almost undamped; torsional and rolling
           friction (condim 6) stand in for the energy a deformable bag dissipates on contact. -->
      <geom name="item_bag_geom" class="item" type="ellipsoid" size="0.08 0.032 0.025" mass="0.15"
        condim="6" friction="1.2 0.05 0.01" rgba="0.55 0.75 0.95 0.9"/>
      <geom name="item_bag_tag" class="visual_only" pos="0 0 0.0252" size="0.024 0.014 0.0012"
        material="evidence_tag"/>
    </body>
    <body name="item_cylinder" pos="0.40 -0.30 0.055">
      <freejoint name="item_cylinder_joint"/>
      <!-- Amber glass, so it reads as a bottle rather than a canister. -->
      <geom name="item_cylinder_geom" class="item" type="cylinder" size="0.025 0.055" mass="0.40"
        rgba="0.58 0.32 0.10 0.93"/>
      <geom name="item_cylinder_tag" class="visual_only" pos="0 0 0.0552" size="0.014 0.009 0.0012"
        material="evidence_tag"/>
    </body>
    <body name="item_folder" pos="0.64 -0.30 0.01">
      <freejoint name="item_folder_joint"/>
      <geom name="item_folder_geom" class="item" type="box" size="0.09 0.03 0.01" mass="0.10"
        rgba="0.93 0.82 0.52 1"/>
      <geom name="item_folder_tag" class="visual_only" pos="0.04 0 0.0102" size="0.028 0.016 0.0012"
        material="evidence_tag"/>
    </body>

    <!-- Invisible look-at targets for the fixed cameras. -->
    <body name="demo_target" pos="0.30 0.10 0.22"/>

    <camera name="demo_cam" pos="1.75 -1.25 1.2" mode="targetbody" target="demo_target" fovy="42"/>
    <camera name="topdown_cam" pos="0.5 -0.12 1.9" xyaxes="0 -1 0 1 0 0" fovy="22"/>
    <camera name="cabinet_cam" pos="0.3 0.22 0.85" xyaxes="1 0 0 0 0.94 0.34" fovy="40"/>
  </worldbody>
</mujoco>
